# ---- Required in production (set these in Vercel → Project → Settings → Environment Variables) ----
# Supabase: Project Settings → Database → Connection string → "Transaction pooler" (port 6543), password filled in
DATABASE_URL=postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Random string, at least 32 characters. Used to sign login sessions.
SESSION_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
# Initial developer password (8+ characters). Change it from the developer panel after the first login.
INITIAL_DEV_PASSWORD=replace-with-a-strong-password

# ---- Optional ----
# Long random token that lets the owner reset the developer password via the login form (leave empty to disable).
DEV_RESET_TOKEN=
# Set to true only if you want the demo courses created on an empty database.
SEED_DEMO=false
